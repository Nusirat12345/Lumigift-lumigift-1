{
  "title": "Lumigift \u2014 Gift Funnel",
  "uid": "lumigift-gift-funnel",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["lumigift", "funnel"],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "type": "bargauge",
      "title": "Gift funnel (selected range)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "targets": [
        {
          "expr": "sum(increase(gifts_created_total[$__range]))",
          "legendFormat": "created",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "sum(increase(gifts_paid_total[$__range]))",
          "legendFormat": "paid",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "sum(increase(gifts_locked_total[$__range]))",
          "legendFormat": "locked",
          "refId": "C",
          "instant": true
        },
        {
          "expr": "sum(increase(gifts_claimed_total[$__range]))",
          "legendFormat": "claimed",
          "refId": "D",
          "instant": true
        },
        {
          "expr": "sum(increase(gifts_expired_total[$__range]))",
          "legendFormat": "expired",
          "refId": "E",
          "instant": true
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Claim rate (7d)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(gifts_claimed_total[7d])) / clamp_min(sum(increase(gifts_locked_total[7d])), 1)",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Funnel events per hour",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(gifts_created_total[1h]))",
          "legendFormat": "created",
          "refId": "A"
        },
        {
          "expr": "sum(increase(gifts_paid_total[1h]))",
          "legendFormat": "paid",
          "refId": "B"
        },
        {
          "expr": "sum(increase(gifts_locked_total[1h]))",
          "legendFormat": "locked",
          "refId": "C"
        },
        {
          "expr": "sum(increase(gifts_claimed_total[1h]))",
          "legendFormat": "claimed",
          "refId": "D"
        },
        {
          "expr": "sum(increase(gifts_expired_total[1h]))",
          "legendFormat": "expired",
          "refId": "E"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Time to claim (unlock \u2192 claim)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(time_to_claim_seconds_bucket[1d])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(time_to_claim_seconds_bucket[1d])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Payment processing time",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(payment_processing_seconds_bucket[1h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(payment_processing_seconds_bucket[1h])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "id": 5
    }
  ]
}
