# ── Testing ───────────────────────────────────────────────────────────────────

# Jest coverage reports (uploaded to Codecov in CI instead)
coverage/
.nyc_output/

# Test snapshots (auto-generated) — never commit watch-mode/obsolete snapshots.
# Intentional baseline snapshots should be committed explicitly.
**/__snapshots__/*.snap
**/__snapshots__/*.snap.bak
**/__snapshots__/*.snap.tmp
contracts/escrow/test_snapshots/

# Playwright test-result artifacts — screenshots, videos, traces.
# These are uploaded as CI artifacts instead of being committed to the repo.
test-results/
playwright-report/

# Playwright visual regression snapshots.
# These SHOULD be committed (they serve as the visual baseline).
# The lines below exclude only the auto-generated temp comparison files that
# Playwright writes during a failed snapshot run (they end in -actual.png
# or -diff.png) — NOT the committed baseline .png files.
e2e/visual/__snapshots__/**/*-actual.png
e2e/visual/__snapshots__/**/*-diff.png
e2e/visual/__snapshots__/**/*-expected.png

# Stryker mutation testing output
.stryker-tmp/
reports/

# Jest worker temp files
jest-worker-*

# Test DB seed artifacts
*.test.db
*.test.sqlite

# ── Rust / Cargo ──────────────────────────────────────────────────────────────
contracts/target/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# Temporary bindings regeneration directory (used by CI sync check)
.bindings-check/

# ── Terraform ─────────────────────────────────────────────────────────────────
infra/terraform/.terraform/
infra/terraform/terraform.tfvars
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/.terraform.lock.hcl

# ── Load test artifacts ───────────────────────────────────────────────────────
# Result files are uploaded as CI artifacts instead of being committed
load-tests/results/

# Kiro IDE
.kiro/

# Turbopack cache
.next/cache/

# ── Vercel / deployment ───────────────────────────────────────────────────────
.vercel

# ── Turbo / monorepo cache ────────────────────────────────────────────────────
.turbo

